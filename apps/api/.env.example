APP_ENV=dev

DATABASE_URL=
DATABASE_URL_DEV=
DATABASE_URL_PROD=

JWT_SECRET=
JWT_REFRESH_SECRET=

PORT=3001
WEB_URL=http://localhost:3000
NODE_ENV=development

RESEND_API_KEY=
PASSWORD_RESET_EMAIL_LOCALE=en
# Resend — MAIL_FROM must match your setup:
# - onboarding@resend.dev: only delivers to your Resend account email (sandbox). Fine for local tests.
# - Production / any real user: verify a domain at https://resend.com/domains, add DNS records, then use e.g. Name <noreply@yourdomain.com>. Paste env values in hosts without extra surrounding quote characters (we strip one pair if present).
MAIL_FROM="GymFlow <onboarding@resend.dev>"
EMAIL_LOGO_URL=https://gymflow.com/logo.png