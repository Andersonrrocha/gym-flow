#!/usr/bin/env tsx
/**
 * Generates apps/web/src/app/tokens.css from packages/design-tokens.
 * Single source of truth: TS objects in packages/design-tokens/src/*.
 */
import { writeFileSync, mkdirSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import {
  lightTokens,
  darkTokens,
  brand,
  accentScale,
  neutral,
  muscleGroupColors,
  radius,
  shadows,
  ease,
  duration,
  fontFamily,
  fontWeight,
  fontSize,
  tracking,
} from "@gymflow/design-tokens";

const __dirname = dirname(fileURLToPath(import.meta.url));
const TARGET = resolve(
  __dirname,
  "..",
  "apps",
  "web",
  "src",
  "app",
  "tokens.css",
);

const camelToKebab = (s: string) =>
  s.replace(/([A-Z])/g, "-$1").toLowerCase();

const semanticBlock = (
  selector: string,
  tokens: Record<string, string>,
): string => {
  const lines = Object.entries(tokens).map(
    ([k, v]) => `  --${camelToKebab(k)}: ${v};`,
  );
  return `${selector} {\n${lines.join("\n")}\n}`;
};

const scaleLines = (prefix: string, scale: Record<string, string>): string =>
  Object.entries(scale)
    .map(([k, v]) => `  --${prefix}-${k}: ${v};`)
    .join("\n");

const flatVarLines = (
  prefix: string,
  obj: Record<string, string | number>,
): string =>
  Object.entries(obj)
    .map(([k, v]) => `  --${prefix}-${camelToKebab(k)}: ${v};`)
    .join("\n");

const header = `/**
 * Auto-generated by scripts/build-tokens.mts.
 * Do not edit by hand. Source: packages/design-tokens/src/*.
 */
`;

const css = [
  header,
  semanticBlock(":root", lightTokens),
  "",
  semanticBlock(".dark", darkTokens),
  "",
  ":root {",
  scaleLines("brand", brand),
  scaleLines("accent", accentScale),
  scaleLines("neutral", neutral),
  flatVarLines("radius", radius),
  flatVarLines("shadow", shadows),
  flatVarLines("ease", ease),
  flatVarLines("duration", duration),
  flatVarLines("muscle", muscleGroupColors),
  flatVarLines("font-size", fontSize),
  flatVarLines("font-weight", fontWeight),
  flatVarLines("font-family", fontFamily),
  flatVarLines("tracking", tracking),
  "}",
  "",
].join("\n");

mkdirSync(dirname(TARGET), { recursive: true });
writeFileSync(TARGET, css);
// eslint-disable-next-line no-console
console.log(`✓ Wrote ${TARGET}`);
